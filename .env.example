# Optional: durable results and global cooldowns across Vercel instances.
# Add these SERVER-SIDE variables in Vercel Settings → Environment Variables.
# Never prefix them with NEXT_PUBLIC_ and never commit real values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional custom production origin for social previews (otherwise uses Vercel's URL).
# SITE_URL=https://your-domain.com

# Optional paid Plus subscription. Keep all these variables server-side.
# Start with sk_test_ and a TEST-mode monthly price to test without real charges.
STRIPE_SECRET_KEY=
STRIPE_PLUS_PRICE_ID=
# Generate a random secret with at least 32 characters.
SESSION_SECRET=
# Separate random private code, at least 32 characters, for free OWNER access.
OWNER_ACCESS_KEY=
